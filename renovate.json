{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["helpers:pinGitHubActionDigests"],
  "ignorePaths": [
    ".github/workflows/check-task-migration.yaml",
    ".github/workflows/update-shared-ci.yaml",
    ".github/workflows/fullsend.yaml",
    ".tekton/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["\\.github/workflows/check-task-yamls\\.yaml$"],
      "matchStrings": [
        "pipeline_version:\\s+(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "tektoncd/pipeline",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["task/.*\\.yaml$"],
      "matchStrings": [
        "image: (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
